# Nature 3D API — Environment Variables
# Copy to .env and fill in real values.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://nature:nature@localhost:5432/nature
DATABASE_URL_SYNC=postgresql+psycopg2://nature:nature@localhost:5432/nature

# --- NVIDIA NIM (AI) ---
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=

# --- App ---
CORS_ORIGINS=http://localhost:5173
LOG_TRANSCRIPTS=false
DEBUG=false

